+++ b/src/features/screen/load-rfb.test.ts
@@ -0,0 +1,25 @@
+import { afterEach, expect, it, vi } from 'vitest'
+import type RFB from '@novnc/novnc'
+import { loadRfb } from './load-rfb'
+
+afterEach(() => vi.useRealTimers())
+
+it('returns the viewer when its probe completes', async () => {
+  const Client = class {} as unknown as typeof RFB
+  await expect(loadRfb(async () => ({ default: Client }))).resolves.toBe(Client)
+})
+
+it('bounds a decoder probe that never settles', async () => {
+  vi.useFakeTimers()
+  const pending = loadRfb(() => new Promise(() => {}))
+  const rejected = expect(pending).rejects.toThrow('timed out')
+  await vi.advanceTimersByTimeAsync(5000)
+  await rejected
+  expect(vi.getTimerCount()).toBe(0)
+})
+
+it('clears the deadline when loading fails', async () => {
+  vi.useFakeTimers()
+  await expect(loadRfb(async () => { throw new Error('load failed') })).rejects.toThrow('load failed')
+  expect(vi.getTimerCount()).toBe(0)
+})
diff --git a/src/features/screen/load-rfb.ts b/src/features/screen/load-rfb.ts
new file mode 100644
index 0000000..80bdb94
--- /dev/null
+++ b/src/features/screen/load-rfb.ts
@@ -0,0 +1,21 @@
+import type RFB from '@novnc/novnc'
+
+// noVNC awaits a WebCodecs probe while its module loads. Some Android devices
+// never finish that probe: keep it out of app startup, and bound the viewer wait.
+export async function loadRfb(
+  load: () => Promise<{ default: typeof RFB }> = () => import('@novnc/novnc'),
+  timeoutMs = 5000,
+): Promise<typeof RFB> {
+  let timer: ReturnType<typeof setTimeout> | undefined
+  try {
+    const module = await Promise.race([
+      load(),
+      new Promise<never>((_, reject) => {
+        timer = setTimeout(() => reject(new Error('Live viewer initialization timed out')), timeoutMs)
+      }),
+    ])
+    return module.default
+  } finally {
+    clearTimeout(timer)
+  }
+}
