FROM --platform=$BUILDPLATFORM caddy:2.11.7-builder-alpine@sha256:aa705b1e8e4bce41a7a30de934c1e00f6821667c1d1206424465065c92cb7674 AS builder
ARG TARGETOS
ARG TARGETARCH
RUN GOOS=$TARGETOS GOARCH=$TARGETARCH xcaddy build v2.11.7 --with github.com/caddy-dns/cloudflare@v0.2.4
FROM caddy:2.11.7-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f
LABEL org.opencontainers.image.source="https://github.com/LivinDuck/umbrel-community-app-store" \
      org.opencontainers.image.title="ClipSync HTTPS helper"
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
COPY caddy-bootstrap.json /etc/caddy/bootstrap.json
# Listen only on a dedicated high TLS port; never HTTP 80/HTTPS 443.
USER 1000:1000
EXPOSE 8443
CMD ["caddy", "run", "--config", "/etc/caddy/bootstrap.json"]
