map ${APP_LIVINDUCK_KASM_DOLLAR}http_upgrade ${APP_LIVINDUCK_KASM_DOLLAR}connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 8080;
    server_name _;
    proxy_ssl_verify off;
    proxy_http_version 1.1;
    proxy_set_header Host ${APP_LIVINDUCK_KASM_DOLLAR}http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade ${APP_LIVINDUCK_KASM_DOLLAR}http_upgrade;
    proxy_set_header Connection ${APP_LIVINDUCK_KASM_DOLLAR}connection_upgrade;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
    client_max_body_size 0;

    # Old bookmarks go directly to Kasm too.
    location = /umbrel { return 302 /; }
    location = /setup { return 302 /setup/; }
    location /setup/ {
        proxy_pass https://livinduck-kasm_server_1:3000;
        # Upstream's wizard reloads itself after completion. Open Kasm instead.
        proxy_set_header Accept-Encoding "";
        proxy_set_header Host ${APP_LIVINDUCK_KASM_DOLLAR}http_host;
        proxy_set_header Upgrade ${APP_LIVINDUCK_KASM_DOLLAR}http_upgrade;
        proxy_set_header Connection ${APP_LIVINDUCK_KASM_DOLLAR}connection_upgrade;
        sub_filter_types application/javascript text/javascript;
        sub_filter 'location.reload(true);' 'location.assign("/");';
    }
    location = /umbrel-health {
        proxy_pass https://livinduck-kasm_server_1:39402/api/__healthcheck;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        add_header Cache-Control "no-store" always;
    }
    location = /starting.html {
        internal;
        default_type text/html;
        add_header Cache-Control "no-store" always;
        return 503 '<!doctype html><html lang="en"><meta charset="utf-8"><meta http-equiv="refresh" content="5"><title>Kasm is starting</title><p>Kasm is starting. This page will open Kasm automatically when it is ready.</p><p>If startup keeps failing, check the Umbrel app logs. <a href="/setup/">Open setup and updates</a>.</p></html>';
    }
    location / {
        # Installation state prevents a slow restart from reopening installation.
        # This directory is read-only and is never served as web content.
        if (!-f /opt/kasm/current/docker/docker-compose.yaml) {
            return 302 /setup/;
        }
        proxy_pass https://livinduck-kasm_server_1:39402;
        proxy_intercept_errors on;
        error_page 502 503 504 =503 /starting.html;
    }
}
