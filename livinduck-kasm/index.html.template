<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Kasm Workspaces</title>
<style>
body{font:17px/1.6 system-ui,sans-serif;max-width:680px;margin:8vh auto;padding:24px;background:#111827;color:#e5e7eb}h1{color:white}a{color:#93c5fd}.actions{display:flex;gap:16px;flex-wrap:wrap}.actions a{background:#1d4ed8;color:white;padding:12px 20px;border-radius:8px;text-decoration:none}small{color:#cbd5e1}
</style>
<h1>Kasm Workspaces</h1>
<p>Run desktops and applications in your browser.</p>
<p id="status" role="status" aria-live="polite">Checking Kasm...</p>
<div class="actions"><a href="/">Setup &amp; updates</a><a id="open" href="#">Open Kasm</a></div>
<p>First time? Open setup, review the Kasm license, choose your administrator and user passwords, and select the workspaces to download. Initial downloads can take several minutes and many gigabytes.</p>
<p>After setup, wait for this page to report that Kasm is ready, then open Kasm and sign in as <strong>admin@kasm.local</strong> with the password you chose. Your browser will show a certificate warning because Kasm starts with a self-signed HTTPS certificate.</p>
<p>Keep the setup wizard enabled if you want to use it for future upgrades. If you disable it, this page and the Open Kasm button remain available.</p>
<small>Setup requires Umbrel login. Kasm uses its own login on HTTPS port 39402. Use a trusted local network; Umbrel remote access does not automatically forward this port.</small>
<script>
const destination = new URL(window.location.href);
destination.protocol = 'https:';
destination.port = '39402';
destination.pathname = '/';
destination.search = '';
destination.hash = '';
const openLink = document.getElementById('open');
openLink.href = destination.href;
async function checkHealth() {
  const status = document.getElementById('status');
  try {
    const response = await fetch('/umbrel-health', {cache: 'no-store', signal: AbortSignal.timeout(8000)});
    const health = response.ok ? await response.json() : {};
    if (health.ok === true) {
      status.textContent = 'Kasm is ready. Select Open Kasm to sign in.';
      status.style.color = '#86efac';
      return;
    }
  } catch (_) {}
  status.textContent = 'Kasm is not ready yet. If you have just installed it, allow several minutes for startup. Keep any running installer open and do not start another installation. If setup reported an error, save its output before retrying.';
  setTimeout(checkHealth, 5000);
}
checkHealth();
</script>
</html>
